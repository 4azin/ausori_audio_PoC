# Langfuse self-host 시크릿.
# 실제 배포 시에는 절대로 이 값을 그대로 쓰지 말 것.
# 로컬 개발에서는 아래 기본값을 그대로 써도 동작한다.

# NextAuth: 32바이트 이상 랜덤 문자열 (openssl rand -hex 32)
NEXTAUTH_SECRET=change-me

# Langfuse salt / encryption key
# ENCRYPTION_KEY 는 반드시 64 hex chars (= 32바이트). openssl rand -hex 32
SALT=change-me
ENCRYPTION_KEY=change-me

# Postgres
POSTGRES_PASSWORD=change-me

# Clickhouse
CLICKHOUSE_PASSWORD=change-me

# Redis
REDIS_AUTH=change-me

# MinIO (S3 호환 블롭 저장소)
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# langfuse API
LANGFUSE_SECRET_KEY=change-me
LANGFUSE_PUBLIC_KEY=change-me
LANGFUSE_HOST=change-me