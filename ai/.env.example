# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# Worker
POLL_INTERVAL=1.0

# Google API Key
GOOGLE_API_KEY=
GEMINI_API_VIDEO=

# Gemini 모델 — 공통 기본 + stage 별 override
# 지정 안 하면 모든 stage 가 GEMINI_MODEL 값을 쓴다.
GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_MODEL_GLOBAL=
# GEMINI_MODEL_GLOBAL_MUSIC=
# GEMINI_MODEL_FOLEY=
# GEMINI_MODEL_NON_FOLEY=

# Langfuse (self-host)
# ai/langfuse/docker-compose.yml 로 띄운 뒤 UI(Project Settings → API Keys)에서 발급
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# 옵션: LLM 호출 로그를 JSONL 로 파일에도 남기기
# LLM_USAGE_LOG=logs/llm_usage.jsonl