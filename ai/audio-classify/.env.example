# ---------------------
# Google API (Gemini Embedding 2)
# ---------------------
GOOGLE_API_KEY=

# ---------------------
# HuggingFace (Gemma 4 E4B 모델 다운로드)
# ---------------------
# https://huggingface.co/settings/tokens 에서 발급
# Gemma 4는 게이트 모델이므로 먼저 https://huggingface.co/google/gemma-4-E4B-it 에서 라이선스 동의 필요
HF_TOKEN=

# ---------------------
# Model Configuration
# ---------------------
# Gemma 4 E4B — 오디오 네이티브 지원 (transformers 로컬 실행)
CAPTION_MODEL=google/gemma-4-E4B-it

# Gemini Embedding 2 for text + audio embeddings (GenAI API)
EMBEDDING_MODEL=gemini-embedding-2-preview

# Embedding output dimensionality (768, 1536, or 3072)
EMBEDDING_DIM=768

# 4-bit 양자화 사용 여부 (8GB VRAM 환경에서 필수)
USE_4BIT=true

# ---------------------
# Database
# ---------------------
DB_PATH=audio_classify.db

# ---------------------
# Sound Library
# ---------------------
SOUND_LIBRARY_ROOT=./sample_data

# ---------------------
# Retrieval Config
# ---------------------
TOP_K_CANDIDATES=50
